import React, { useState } from "react";
import {
  Typography,
  Box,
  TextField,
  FormControl,
  InputLabel,
  MenuItem,
  Select,
  Button,
} from "@mui/material";
import DeleteIcon from "@mui/icons-material/Delete";

const ProductForm = ({ setTitle, setSubtitle, setPrice, setQty, setTag, setCategory, setSize, setColor, title, subtitle, price, qty, tag, category, size, color }) => {
  const handleChange = (event) => {
    setCategory(event.target.value);
  };

  return (
    <Box component="form" sx={{ padding: 4, borderRadius: 8 }}>
      <Typography variant="h5" gutterBottom>
        Create Product
      </Typography>
      <Box sx={{ display: "flex", flexDirection: "row", justifyContent: "space-between", width: "100%" }}>
        <Box sx={{ flex: 1, display: "flex", flexDirection: "column", gap: "16px" }}>
          <TextField
            label="Product Name"
            value={title}
            onChange={(e) => setTitle(e.target.value)}
            fullWidth
            margin="normal"
          />
          <TextField
            label="SubTitle"
            value={subtitle}
            onChange={(e) => setSubtitle(e.target.value)}
            fullWidth
            margin="normal"
          />
          <TextField
            label="Price"
            value={price}
            onChange={(e) => setPrice(e.target.value)}
            fullWidth
            margin="normal"
            type="number"
          />
          <TextField
            label="Quantity"
            value={qty}
            onChange={(e) => setQty(e.target.value)}
            fullWidth
            margin="normal"
            type="number"
          />
          <TextField
            label="Tag"
            value={tag}
            onChange={(e) => setTag(e.target.value)}
            fullWidth
            margin="normal"
          />
        </Box>

        <Box sx={{ flex: 1, borderLeft: "2px solid #e0e0e0", paddingLeft: "20px", marginLeft: "20px", display: "flex", flexDirection: "column", justifyContent: "space-between" }}>
          <FormControl fullWidth margin="normal">
            <InputLabel>Category</InputLabel>
            <Select value={category} onChange={handleChange} label="Category">
              <MenuItem value="Shirts">Shirts</MenuItem>
              <MenuItem value="Pants">Pants</MenuItem>
              <MenuItem value="Shoes">Shoes</MenuItem>
            </Select>
          </FormControl>
          <TextField
            label="Size"
            value={size}
            onChange={(e) => setSize(e.target.value)}
            fullWidth
            margin="normal"
          />
          <TextField
            label="Color"
            value={color}
            onChange={(e) => setColor(e.target.value)}
            fullWidth
            margin="normal"
          />
        </Box>
      </Box>

      <Box sx={{ display: "flex", justifyContent: "space-between", mt: 3, width: "100%" }}>
        <Button variant="outlined" startIcon={<DeleteIcon />}>
          Delete Product
        </Button>
        <Button variant="contained">Upload Product</Button>
      </Box>
    </Box>
  );
};

export default ProductForm;




import React, { useState } from "react";
import { Box, Typography } from "@mui/material";

const ImageUpload = ({ setImage }) => {
  const [imagePreview, setImagePreview] = useState(null);

  const handleImageUpload = (event) => {
    const file = event.target.files[0];
    setImage(URL.createObjectURL(file)); // Preview the image
    setImagePreview(URL.createObjectURL(file)); // Display preview
  };

  return (
    <Box sx={{ width: "100%", mt: 4 }}>
      <Typography variant="h6">Upload Product Image</Typography>
      <input type="file" onChange={handleImageUpload} />
      {imagePreview && (
        <Box sx={{ mt: 2 }}>
          <Typography variant="body2" color="textSecondary">
            Image Preview:
          </Typography>
          <img
            src={imagePreview}
            alt="Product Preview"
            style={{ width: "100%", maxWidth: "300px" }}
          />
        </Box>
      )}
    </Box>
  );
};

export default ImageUpload;



import React, { useState, Suspense, lazy } from "react";
import { Box, Button } from "@mui/material";
import { CircularProgress } from "@mui/material";

const ProductForm = lazy(() => import("./ProductForm"));
const ImageUpload = lazy(() => import("./ImageUpload"));

const AddProducts = () => {
  const [title, setTitle] = useState("");
  const [subtitle, setSubtitle] = useState("");
  const [price, setPrice] = useState(0);
  const [qty, setQty] = useState(0);
  const [size, setSize] = useState("");
  const [tag, setTag] = useState("");
  const [category, setCategory] = useState("");
  const [color, setColor] = useState("");
  const [image, setImage] = useState(null);

  return (
    <Box sx={{ position: "absolute", left: "50%", transform: "translate(-50%, 0)", width: "100%", maxWidth: "1500px", bgcolor: "background.paper", border: "none", boxShadow: 24, p: 4, borderRadius: "8px", display: "flex", justifyContent: "center", alignItems: "flex-start", flexDirection: "column" }}>
      <Suspense fallback={<CircularProgress />}>
        <ProductForm
          setTitle={setTitle}
          setSubtitle={setSubtitle}
          setPrice={setPrice}
          setQty={setQty}
          setTag={setTag}
          setCategory={setCategory}
          setSize={setSize}
          setColor={setColor}
          title={title}
          subtitle={subtitle}
          price={price}
          qty={qty}
          tag={tag}
          category={category}
          size={size}
          color={color}
        />
        <ImageUpload setImage={setImage} />
      </Suspense>
    </Box>
  );
};

export default AddProducts;
